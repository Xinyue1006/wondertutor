# Backend API base URL (leave as /api in dev — Vite proxies it to localhost:5000)
VITE_API_URL=/api
# Google OAuth client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
# Google reCAPTCHA v2 site key
VITE_RECAPTCHA_SITE_KEY=
# Email address shown on the Privacy Notice for questions about personal data (optional; leave empty to show the centre instead)
VITE_PRIVACY_EMAIL=
