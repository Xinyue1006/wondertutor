# ── Server ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173  # the site address: used for CORS and for the links in emails and calendar files (set it to the live address when deployed)

# ── Database (MySQL) ──
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/wondertutor"

# ── Auth ──
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# ── Email (Gmail SMTP: use an App Password, not your normal password) ──
# Leave SMTP_USER empty in development -> OTP codes are printed to the console instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WonderTutor <no-reply@wondertutor.local>"

# ── Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, Web) ──
GOOGLE_CLIENT_ID=

# ── Google reCAPTCHA v2 (leave empty in development to skip the check) ──
RECAPTCHA_SECRET=

# ── Billplz payment gateway (leave empty to use the built-in test gateway) ──
# Sandbox account: sign up at billplz-sandbox.com, create a Collection, then copy the keys from Settings.
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE=
BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api   # live: https://www.billplz.com/api

# ── Cloudinary (image uploads, add later) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Production only ──
# ADMIN_PASSWORD=choose-a-strong-password   (used by db:seed for the admin account)

# ── Read-only AI assistant (Gemini, Phase 1) ──
# Off by default: the guided tutor search keeps working without any key. When enabled, sanitised questions and short
# record excerpts are sent to Google's Gemini API, so review docs/AI_ASSISTANT.md (privacy) before enabling with real data.
AI_ASSISTANT_ENABLED=false
GEMINI_API_KEY=            # server-side only; never put it in the frontend or in a VITE_ variable
GEMINI_MODEL=gemini-3.5-flash-lite # selected in local live comparisons; check free-tier availability for your project
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_TOOL_ROUNDS=4
AI_MAX_TOOL_CALLS=8
AI_CONVERSATION_TTL_MS=1800000
AI_MAX_TURNS=20
AI_MAX_CONVERSATIONS_PER_USER=5
AI_MAX_CONVERSATIONS=1000
AI_MESSAGES_PER_MINUTE=10
AI_MAX_OUTPUT_TOKENS=800

# Managed Hostinger: set false and schedule scripts/run-housekeeping.js every 5 minutes.
# Keep the timer enabled for local development when no external cron is configured.
SCHEDULER_ENABLED=true
