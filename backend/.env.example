# ── Server ──
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database (MySQL) ──
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/wondertutor"

# ── Auth ──
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# ── Email (Gmail SMTP: use an App Password, not your normal password) ──
# Leave SMTP_USER empty in development -> OTP codes are printed to the console instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WonderTutor <no-reply@wondertutor.local>"

# ── Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, Web) ──
GOOGLE_CLIENT_ID=

# ── Google reCAPTCHA v2 (leave empty in development to skip the check) ──
RECAPTCHA_SECRET=

# ── Cloudinary (image uploads, add later) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
